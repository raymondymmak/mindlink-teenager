{
  "name": "MindLink (Expo)",
  "install": "npm ci --legacy-peer-deps",
  "terminals": [
    {
      "name": "expo-web",
      "command": "EXPO_PUBLIC_GEMINI_API_KEY=\"${GEMINI_KEY:-}\" EXPO_PUBLIC_GEMINI_MODEL=\"${EXPO_PUBLIC_GEMINI_MODEL:-auto}\" npx expo start --web --port 8081"
    }
  ],
  "ports": [
    {
      "name": "expo-web",
      "port": 8081
    }
  ]
}
