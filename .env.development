# Non-secret Metro env context so `npx expo start` can mount when `.env` is absent.
# Copy `.env.example` to `.env` for a local Gemini key. Never put secrets here.
EXPO_PUBLIC_GEMINI_MODEL=auto
# Public API gate (not GEMINI_KEY / PINECONE_KEY). Must match server MINDLINK_API_TOKEN.
EXPO_PUBLIC_MINDLINK_API_TOKEN=mindlink-demo-gate-v1
