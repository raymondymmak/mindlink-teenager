# Copy this file to `.env` and restart Expo (`npx expo start`).
# Get a Gemini key from Google AI Studio: https://aistudio.google.com/apikey
# Never commit `.env` or hardcode keys in source.
#
# Cloud / fresh VMs: if Expo red-screens with "No modules in context", Metro
# found zero of .env, .env.development, .env.local, .env.development.local.
# Run `node scripts/ensure-dotenv.js` (also hooked from npm start / postinstall)
# then restart Expo with --reset-cache. Do not commit secrets.

# auto = in-app routing (chat → Flash-Lite, Session Brief → Flash).
# Pin a model id to force every call onto that model. This is not a secret.
EXPO_PUBLIC_GEMINI_MODEL=auto

# Optional client override. Default is same-origin `/api/gemini` on web,
# or https://raymondmak-app1.expo.app/api/gemini on native / Node.
# EXPO_PUBLIC_GEMINI_API_URL=https://raymondmak-app1.expo.app/api/gemini

# Optional client override for Pinecone RAG. Default is same-origin `/api/context`
# on web, or https://raymondmak-app1.expo.app/api/context on native / Node.
# EXPO_PUBLIC_CONTEXT_API_URL=https://raymondmak-app1.expo.app/api/context

# Server-only secrets for Expo Router API routes (POST /api/gemini, POST /api/context).
# Never prefix these with EXPO_PUBLIC_ — they must not ship in the client bundle.
# GEMINI_KEY=
# GEMINI_API_KEY=
# PINECONE_KEY=
# PINECONE_API_KEY=
# PINECONE_INDEX=mindlink-knowledge-base
# PINECONE_HOST=
# GEMINI_MODEL=auto
