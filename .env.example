# Copy this file to `.env` and restart Expo (`npx expo start`).
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# Never commit `.env` or hardcode keys in source.

EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash

# Optional client override. Default is same-origin `/api/context` on web,
# or https://raymondmak-app1.expo.app/api/context on native / Node.
# EXPO_PUBLIC_CONTEXT_API_URL=https://raymondmak-app1.expo.app/api/context

# Server-only aliases for POST /api/context (Expo Router API route).
# Never prefix these with EXPO_PUBLIC_ — they must not ship in the client bundle.
# PINECONE_KEY=
# PINECONE_API_KEY=
# GEMINI_KEY=
# GEMINI_API_KEY=
# PINECONE_INDEX=mindlink-knowledge-base
# PINECONE_HOST=

# Optional aliases used by local/Node scripts (not inlined into Expo web unless
# copied to EXPO_PUBLIC_GEMINI_API_KEY before `npx expo export -p web`):
# GEMINI_API_KEY=
# GEMINI_KEY=
