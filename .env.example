# Copy this file to `.env` and restart Expo (`npx expo start`).
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# Never commit `.env` or hardcode the key in source.

EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash

# Middleman Pinecone RAG (POST { query } → { context, matches }).
# Gemini Flash stays in-app; never put PINECONE_KEY in Expo.
EXPO_PUBLIC_CONTEXT_API_URL=https://gemini-middleman-zeta.vercel.app/api/context

# Optional aliases used by local/Node scripts (not inlined into Expo web unless
# copied to EXPO_PUBLIC_GEMINI_API_KEY before `npx expo export -p web`):
# GEMINI_API_KEY=
# GEMINI_KEY=
